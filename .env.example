# ============================================
# Supermarket POS - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to Git.

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supermarket_dev
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=supermarket_dev
PG_PORT=5432

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Authentication ----
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_64_CHAR_STRING
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# ---- Backend ----
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development
API_URL=http://localhost:3000

# ---- Encryption ----
ENCRYPTION_KEY=CHANGE_ME_TO_A_RANDOM_32_BYTE_HEX_STRING

# ---- Admin Web ----
VITE_API_URL=http://localhost:3000/api/v1

# ---- Electron / Desktop ----
DESKTOP_API_URL=http://localhost:3000/api/v1
