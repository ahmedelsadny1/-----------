{
  "name": "@supermarket/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -n main,renderer \"pnpm dev:main\" \"pnpm dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "build": "pnpm build:renderer && pnpm build:main",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rimraf dist out"
  },
  "dependencies": {
    "@supermarket/shared": "workspace:*",
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "^0.33.0",
    "electron-updater": "^6.3.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.55.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "electron": "^32.1.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.9.0",
    "postcss": "^8.4.45",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",
    "rimraf": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "zustand": "^4.5.0"
  },
  "build": {
    "appId": "com.supermarket.pos",
    "productName": "Supermarket POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!node_modules/**/*"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "src/renderer/assets/images/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
